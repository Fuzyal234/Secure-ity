# Flask Application Configuration
ENV=production
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# Supabase Database Configuration
# Get your connection string from Supabase Dashboard > Settings > Database
# Option 1: Direct connection (port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Option 2: Connection pooler (port 6543) - Recommended for production
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres
# 
# Example:
# DATABASE_URL=postgresql://postgres:your-password@db.abcdefghijklmnop.supabase.co:6543/postgres?sslmode=require
DATABASE_URL=your-supabase-connection-string-here
# Alternative: Use SUPABASE_DATABASE_URL instead
# SUPABASE_DATABASE_URL=your-supabase-connection-string-here

# Redis Configuration (optional for local development; defaults to in-memory rate limits)
# Provide a Redis URL in production to enable shared rate limiting & token blacklist storage.
# REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=your-redis-password

# Supabase (used by backend instead of direct SQL)
# Get these from Supabase Project Settings
SUPABASE_URL=https://your-project-ref.supabase.co
# Prefer service role key on backend (keep it secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: anon key if you don't have service role (more restrictive)
# SUPABASE_ANON_KEY=your-anon-key

# Encryption Configuration
# Generate a key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-base64-encoded-encryption-key-here

# Session Management
# Optional: override default 24h session lifetime (in seconds)
# SESSION_TTL_SECONDS=86400

# Logging Configuration
LOG_LEVEL=INFO

# CORS Configuration (comma-separated list of allowed origins)
# CORS_ORIGINS=https://example.com,https://another-domain.com

