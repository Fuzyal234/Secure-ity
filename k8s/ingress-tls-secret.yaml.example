# Example TLS secret for Ingress
# For production, use cert-manager or provide your own TLS certificates
#
# Create TLS secret from certificate files:
# kubectl create secret tls secure-ity-tls \
#   --cert=path/to/certificate.crt \
#   --key=path/to/private.key \
#   --namespace=secure-ity
#
# Or use cert-manager for automatic certificate management:
# Install cert-manager and use Certificate resource instead

apiVersion: v1
kind: Secret
metadata:
  name: secure-ity-tls
  namespace: secure-ity
type: kubernetes.io/tls
data:
  # Base64 encoded certificate
  tls.crt: |
    LS0tLS1CRUdJTiBDRVJUSUZJQ0FURS0tLS0tCi4uLgo=
  # Base64 encoded private key
  tls.key: |
    LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCi4uLgo=

